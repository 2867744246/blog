---
import { withBase } from '../utils/base';

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
	<div class="relative z-10 flex flex-wrap gap-2">
		{/* z-10 抬升标签层，避免被 PostCard 标题链接的整卡点击覆盖层挡住 */}
		{tags.map((tag) => (
			<a href={withBase(`/tags/${tag}/`)} class="text-xs text-amber-700 hover:underline dark:text-amber-400">
				#{tag}
			</a>
		))}
	</div>
)}
